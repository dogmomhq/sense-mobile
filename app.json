{
  "expo": {
    "name": "sense-mobile",
    "slug": "sense-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "runtimeVersion": { "policy": "appVersion" },
    "updates": {
      "enabled": true,
      "url": "https://u.expo.dev/ee740f0c-1158-49cb-86a6-b5ed2d72f8b6",
      "fallbackToCacheTimeout": 0
    },
    "plugins": [
      ["expo-font", { "fonts": [
        "./assets/fonts/Inter_400Regular.ttf",
        "./assets/fonts/Inter_500Medium.ttf",
        "./assets/fonts/Inter_600SemiBold.ttf",
        "./assets/fonts/Inter_700Bold.ttf",
        "./assets/fonts/Inter_800ExtraBold.ttf",
        "./assets/fonts/Inter_900Black.ttf"
      ]}],
      "expo-apple-authentication"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dogmomhq.sensemobile",
      "usesAppleSignIn": true,
      "infoPlist": { "ITSAppUsesNonExemptEncryption": false }
    },
    "android": {
      "package": "com.dogmomhq.sensemobile",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": { "favicon": "./assets/favicon.png", "output": "single" },
    "extra": { "eas": { "projectId": "ee740f0c-1158-49cb-86a6-b5ed2d72f8b6" } }
  }
}
